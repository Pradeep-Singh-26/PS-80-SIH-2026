# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Data (raw/processed can be large and/or license-restricted — never commit)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts
*.pkl
*.joblib
*.h5
*.pt

# Outputs (regenerated by run_pipeline.py — don't commit generated results)
outputs/*
!outputs/.gitkeep
!outputs/figures/.gitkeep
!outputs/verification_report/.gitkeep

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Env / secrets
.env
*.env.local
