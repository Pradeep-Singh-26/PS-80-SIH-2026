# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Data (raw/processed can be large and/or license-restricted — never commit)
data/raw/*
!data/raw/.gitkeep
!data/raw/district_shapefile/
data/raw/district_shapefile/*
!data/raw/district_shapefile/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Model artifacts / MLOps registry (versioned separately, not via git)
*.pkl
*.joblib
*.h5
*.pt
models/*
!models/.gitkeep
mlruns/

# Outputs (regenerated by run_pipeline.py — don't commit generated results)
outputs/*
!outputs/.gitkeep
!outputs/figures/
outputs/figures/*
!outputs/figures/.gitkeep
!outputs/verification_report/
outputs/verification_report/*
!outputs/verification_report/.gitkeep
!outputs/alerts_log/
outputs/alerts_log/*
!outputs/alerts_log/.gitkeep

# Dashboard / web build artifacts
dashboard/web/node_modules/
dashboard/web/build/
dashboard/web/dist/

# Docker / infra local state
infra/docker/*.env

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Env / secrets
.env
*.env.local
